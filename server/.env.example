# Credenciales OAuth 2.0 creadas en Google Cloud Console (tipo "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con el URI de redireccion autorizado en Google Cloud Console
# Local:      http://localhost:3000/auth/callback
# Produccion: https://tu-dominio.com/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ID del calendario de Marisol. "primary" si es su calendario principal de Google.
CALENDAR_ID=primary

# Clave para entrar al panel de pacientes (admin.html). Invéntala tú, guárdala en un lugar seguro.
ADMIN_KEY=cambia-esta-clave

# Opcional — Supabase como base de datos de pacientes.
# Déjalas vacías para seguir usando el archivo local server/patients.json.
# Cuando tengas tu proyecto de Supabase: corre server/schema.sql en su SQL Editor,
# y copia aquí la Project URL y la Service Role Key (Project Settings > API).
# La Service Role Key nunca se expone al navegador, solo la usa este servidor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Puerto local (Render/Railway lo asignan solos, no hace falta tocarlo en produccion)
PORT=3000
